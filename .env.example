# Required: the only value you have to change to run the assistant.
OPENROUTER_API_KEY=your-openrouter-key

# Local development defaults. Docker Compose overrides DATABASE_URL for the API container.
DATABASE_URL=postgresql+psycopg://series76:series76@127.0.0.1:5433/series76
JWT_SECRET=local-development-secret-do-not-deploy-anywhere

# Models used by ingest.py to transcribe the PDF tables.
EXTRACTION_MODEL=anthropic/claude-haiku-5.5
EXTRACTION_VERIFY_MODEL=google/gemini-3.1-flash-lite
